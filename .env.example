# Workspace
MW_WORKSPACE_ROOT=workspace
MW_BRAND_FILE=brand/default/brand.yaml
MW_MAX_IMAGE_RETRIES=1
MW_REQUEST_TIMEOUT=180

# Text planning: mock | openai_compatible
MW_LLM_PROVIDER=mock
MW_LLM_BASE_URL=https://api.openai.com/v1
MW_LLM_API_KEY=
MW_LLM_MODEL=gpt-5-mini
MW_LLM_JSON_SCHEMA=true
MW_LLM_TEMPERATURE=0.2
MW_LLM_MAX_TOKENS=8000

# GLM example (general API, not Coding Plan endpoint)
# MW_LLM_PROVIDER=openai_compatible
# MW_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MW_LLM_API_KEY=your_key
# MW_LLM_MODEL=glm-5.2
# MW_LLM_JSON_SCHEMA=false

# Images: mock | manual | openai
MW_IMAGE_PROVIDER=mock
MW_IMAGE_BASE_URL=https://api.openai.com/v1
MW_IMAGE_API_KEY=
MW_IMAGE_MODEL=gpt-image-2
MW_IMAGE_SIZE=1024x1536
MW_IMAGE_QUALITY=high
MW_IMAGE_OUTPUT_FORMAT=png
MW_IMAGE_USE_REFERENCE_EDIT=false

# Optional multimodal critic: off | openai_compatible
MW_VISION_PROVIDER=off
MW_VISION_BASE_URL=https://api.openai.com/v1
MW_VISION_API_KEY=
MW_VISION_MODEL=gpt-5-mini

# Web
MW_HOST=127.0.0.1
MW_PORT=8000
